Name:           aha2
Version:        @VERSION@
Release:        1
Summary:        Local agent control plane
License:        Proprietary
BuildArch:      @RPM_ARCH@
Source0:        aha2
Source1:        aha2.service
Source2:        aha2.env
Requires(pre):  shadow-utils
Requires:       systemd
Requires(post): systemd
Requires(preun): systemd
AutoReqProv:    no

%description
AHA2 provides a local web control plane for agent tasks, knowledge,
hardware debugging, and managed processes.

%prep

%build

%install
install -D -m 0755 %{SOURCE0} %{buildroot}/usr/bin/aha2
install -D -m 0644 %{SOURCE1} %{buildroot}/usr/lib/systemd/system/aha2.service
install -D -m 0644 %{SOURCE2} %{buildroot}/etc/aha2/aha2.env

%pre
getent group aha2 >/dev/null 2>&1 || groupadd --system aha2
getent passwd aha2 >/dev/null 2>&1 || useradd --system --gid aha2 --home-dir /var/lib/aha2 --no-create-home --shell /sbin/nologin aha2

%post
install -d -m 0750 -o aha2 -g aha2 /var/lib/aha2
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable aha2.service
    if systemctl is-active --quiet aha2.service; then
        systemctl restart aha2.service
    else
        systemctl start aha2.service
    fi
fi

%preun
if [ "$1" -eq 0 ] && command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    systemctl stop aha2.service
    systemctl disable aha2.service
fi

%postun
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    systemctl daemon-reload
fi

%files
%attr(0755,root,root) /usr/bin/aha2
/usr/lib/systemd/system/aha2.service
%config(noreplace) /etc/aha2/aha2.env

%changelog
* Thu Jan 01 1970 AHA2 maintainers - @VERSION@-1
- Packaged AHA2 system service.
